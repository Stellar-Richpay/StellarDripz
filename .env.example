# ─── StellarDripz Environment Variables ─────────────────────────────
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it's gitignored.

# =============================================================================
# Required — Stellar Network Configuration
# =============================================================================

# Soroban RPC endpoint (smart contracts)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon API endpoint (transactions, balances)
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar network identifier
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Network passphrase for transaction signing
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Friendbot URL for testnet XLM faucet
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org

# Stellar Expert block explorer URL
NEXT_PUBLIC_STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet

# Soroban contract explorer URL
NEXT_PUBLIC_CONTRACT_EXPLORER_URL=https://stellar.expert/explorer/testnet/contract

# =============================================================================
# Optional — Deployed Contract IDs (set after deployment)
# =============================================================================

# Set these after running: npm run contracts:deploy
# NEXT_PUBLIC_CONTRACT_COUNTER=C...
# NEXT_PUBLIC_CONTRACT_DRIP_TOKEN=C...
# NEXT_PUBLIC_CONTRACT_DRIP_POOL=C...
# NEXT_PUBLIC_CONTRACT_GOVERNANCE=C...
# NEXT_PUBLIC_CONTRACT_BADGE=C...

# =============================================================================

# WalletConnect (get a project ID at https://cloud.reown.com)
# Without this, WalletConnect QR pairing is disabled
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Recommended — Supabase Database (production persistence)
# =============================================================================
# 1. Create a free project at https://supabase.com
# 2. Get these from Project Settings → API
# 3. Run: npm run db:migrate (applies the schema from supabase-schema.sql)
#
# Without these, the app uses an in-memory store with JSON file fallback.
# For production, Supabase is strongly recommended.

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# Optional — Rate Limiting (milliseconds)
# =============================================================================

# RATE_LIMIT_FAUCET_MS=60000
# RATE_LIMIT_CONTRACT_MS=30000
# RATE_LIMIT_GENERAL_MS=10000

# =============================================================================
# Optional — Logging
# =============================================================================

# LOG_LEVEL=debug  # debug | info | warn | error (default: info in prod, debug in dev)

# =============================================================================
# Optional — Admin Analytics (protect /admin and /api/analytics)
# =============================================================================

# When set, /api/analytics (and the /admin dashboard) require this token via
# `Authorization: Bearer <token>` or `x-admin-token`. Always set this in
# production — without it the analytics endpoint is open to anyone.
# ADMIN_API_TOKEN=change-me-to-a-long-random-string

# =============================================================================
# Optional — Deployment (never commit real keys)
# =============================================================================

# DEPLOYER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
