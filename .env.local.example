# StellarDripz Environment Configuration
# Copy this file to .env.local to customize.
# The full annotated list lives in .env.example — this file is the minimal
# working set with the same keys the code actually reads.

# ─── Stellar Network (TESTNET or MAINNET) ───────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Horizon API Endpoint
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Friendbot Faucet Endpoint (testnet only)
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org

# Stellar Expert Explorer
NEXT_PUBLIC_STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet

# Network Passphrase
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC Endpoint (for smart contracts)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Contract Explorer URL
NEXT_PUBLIC_CONTRACT_EXPLORER_URL=https://stellar.expert/explorer/testnet/contract

# ─── Optional — Deployed contract IDs (after `npm run contracts:deploy`) ─
# NEXT_PUBLIC_CONTRACT_COUNTER=C...
# NEXT_PUBLIC_CONTRACT_DRIP_TOKEN=C...
# NEXT_PUBLIC_CONTRACT_DRIP_POOL=C...
# NEXT_PUBLIC_CONTRACT_GOVERNANCE=C...
# NEXT_PUBLIC_CONTRACT_BADGE=C...

# ─── Optional — WalletConnect QR pairing ────────────────────────────────
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Optional — Supabase (production persistence/analytics) ─────────────
# Create a project at https://supabase.com, then use Project Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Optional — Protect /admin and /api/analytics (always set in prod) ──
# ADMIN_API_TOKEN=change-me-to-a-long-random-string

# ─── Optional — Rate limiting windows (ms) ──────────────────────────────
# RATE_LIMIT_FAUCET_MS=60000
# RATE_LIMIT_CONTRACT_MS=30000
# RATE_LIMIT_GENERAL_MS=10000

# ─── Optional — Logging ─────────────────────────────────────────────────
# LOG_LEVEL=debug  # debug | info | warn | error

# ─── Optional — Deployment ──────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://stellardripz.vercel.app
# DEPLOYER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
