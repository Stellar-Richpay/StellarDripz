{
  "ignorePatterns": [
    {
      "pattern": "^https://github.com/Stellar-Richpay/StellarDripz"
    },
    {
      "pattern": "^http://localhost"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^.attached",
      "replacement": "file://"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com"],
      "headers": {
        "Accept": "text/html"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "aliveStatusCodes": [200, 206, 403]
}
