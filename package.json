{
  "name": "stellardripz",
  "version": "2.0.0",
  "license": "MIT",
  "keywords": [
    "stellar",
    "soroban",
    "faucet",
    "smart-contracts",
    "nextjs",
    "blockchain",
    "web3",
    "testnet"
  ],
  "repository": "https://github.com/StellarDripz/StellarDripz",
  "private": true,
  "description": "StellarDripz — Production-grade Stellar dApp with advanced Soroban smart contracts (DripToken, DripPool, DripGovernance, DripBadge), multi-wallet faucet, real-time event streaming, and CI/CD pipeline.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "test": "jest --passWithNoTests --verbose",
    "verify": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "verify:contracts": "npm run contracts:fmt:check && npm run contracts:clippy && npm run contracts:test",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "contracts:build": "cd contracts && cargo build --target wasm32v1-none --release",
    "contracts:test": "cd contracts && cargo test --verbose",
    "contracts:clippy": "cd contracts && cargo clippy --all-targets -- -D warnings",
    "contracts:fmt": "cd contracts && cargo fmt",
    "contracts:fmt:check": "cd contracts && cargo fmt --check",
    "contracts:deploy": "npx ts-node --transpile-only scripts/deploy-contract.ts",
    "db:migrate": "npx ts-node --transpile-only scripts/migrate-db.ts",
    "clean": "rm -rf .next contracts/target"
  },
  "dependencies": {
    "@albedo-link/intent": "^0.12.0",
    "@lobstrco/signer-extension-api": "^2.1.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "@walletconnect/sign-client": "^2.23.10",
    "@walletconnect/types": "^2.23.10",
    "next": "^14.2.35",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.2"
  },
  "overrides": {
    "axios": "1.18.0",
    "glob": "^10.5.0",
    "postcss": "^8.5.26"
  }
}
